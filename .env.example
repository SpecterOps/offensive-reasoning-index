# ORI — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit real credentials.
#
# Shell exports and CI/CD variables always take precedence over values here.

# ── BloodHound CE ────────────────────────────────────────────────────────────
BLOODHOUND_DOMAIN=bloodhound.example.com
BLOODHOUND_TOKEN_ID=your-token-id-uuid
BLOODHOUND_TOKEN_KEY=your-token-key
BLOODHOUND_SCHEME=https
# BLOODHOUND_PORT=443        # uncomment if not using standard port

# ── Model API Keys ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...         # for gemini/gemini-2.0-flash etc.

# ── Ollama (local models) ────────────────────────────────────────────────────
# Default is http://localhost:11434 — override if Ollama runs on another host.
# OLLAMA_BASE_URL=http://192.168.1.100:11434
